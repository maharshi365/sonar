{
  "name": "@sonar/core",
  "version": "0.1.0",
  "private": true,
  "description": "Rust core native addon for Sonar",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "*.dll",
    "*.dylib",
    "*.so",
    "*.so.*"
  ],
  "napi": {
    "name": "sonar-core",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
