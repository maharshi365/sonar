{
  "name": "sonar",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first desktop speech-to-text",
  "author": "Maharshi Patel",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build:native": "npm --prefix src/crates/sonar-core run build",
    "build:native:debug": "npm --prefix src/crates/sonar-core run build:debug",
    "dev": "npm run build:native:debug && electron-vite dev --config src/desktop/electron.vite.config.ts",
    "build": "npm run build:native && electron-vite build --config src/desktop/electron.vite.config.ts",
    "package": "npm run build && electron-builder --publish never",
    "preview": "electron-vite preview --config src/desktop/electron.vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sonar/core": "file:src/crates/sonar-core",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.30",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.sonar.desktop",
    "productName": "Sonar",
    "publish": {
      "provider": "github",
      "owner": "maharshi365",
      "repo": "sonar"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/@sonar/core/target{,/**/*}",
      "!node_modules/@sonar/core/src{,/**/*}",
      "!node_modules/@sonar/core/build.rs",
      "!node_modules/@sonar/core/Cargo.toml",
      "!node_modules/@sonar/core/package-lock.json"
    ],
    "asarUnpack": [
      "node_modules/@sonar/core/*.node",
      "node_modules/@sonar/core/*.dll",
      "node_modules/@sonar/core/*.dylib",
      "node_modules/@sonar/core/*.so",
      "node_modules/@sonar/core/*.so.*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.svg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sonar uses microphone audio for local speech-to-text transcription."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.svg",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.svg"
    }
  }
}
