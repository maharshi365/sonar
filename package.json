{
  "name": "sonar",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop speech-to-text",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build:native": "npm --prefix src/crates/sonar-core run build",
    "build:native:debug": "npm --prefix src/crates/sonar-core run build:debug",
    "dev": "npm run build:native:debug && electron-vite dev --config src/desktop/electron.vite.config.ts",
    "build": "npm run build:native && electron-vite build --config src/desktop/electron.vite.config.ts",
    "preview": "electron-vite preview --config src/desktop/electron.vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sonar/core": "file:src/crates/sonar-core",
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.30",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
